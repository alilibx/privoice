# Dart/Flutter
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
.idea/
.vscode/

# Android
.gradle/
local.properties
*.keystore
key.properties

# iOS/macOS (not built now, keep clean anyway)
**/Pods/
*.xcworkspace/xcuserdata/

# Models (never commit — large, fetched on device)
**/models/*.onnx
**/models/*.bin
**/models/*.gguf
.cache/
*.tar.bz2

# Recorded audio
*.wav

# macOS
.DS_Store

# stray tool logs
firebase-debug.log
pglite-debug.log
*-debug.log

# Claude Code local config. settings.local.json is machine-specific (per-machine
# permission grants); launch.json describes this checkout's dev-server ports.
# Neither belongs in history — but keep .claude/ itself unignored so a shared
# settings.json or skills/ can be committed deliberately later.
.claude/settings.local.json
.claude/launch.json
